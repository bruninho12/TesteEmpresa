generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}


model Produto {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  nome      String
  preco     Float
  imagem    String?
  categoria String?
}

model Pedido {
  id      String   @id @default(auto()) @map("_id") @db.ObjectId
  itens   String   // Armazena o JSON dos itens
  status  String   @default("PENDENTE")
  senha   String
  total   Float
  data    DateTime @default(now())
}


